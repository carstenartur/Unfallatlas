{
  "name": "unfallatlas",
  "version": "2.1.4",
  "description": "Unfallatlas data converter and analysis tool with interactive visualization",
  "main": "index.js",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build:site": "node scripts/build-site.js",
    "build:pages-profile": "node scripts/build-public-pages-profile.js",
    "serve:site": "node scripts/serve-site.js",
    "serve:site:existing": "node scripts/serve-site.js --no-build --site _site",
    "fingerprint:site": "node scripts/fingerprint-static-tree.js",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=tests/unit",
    "test:integration": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && jest --testPathPatterns=tests/integration --runInBand --json --outputFile=coverage/integration-results.json",
    "test:integration:tc": "NODE_OPTIONS=--experimental-vm-modules jest --config=tests/integration/jest.testcontainers.config.js",
    "test:location-brief-golden:tc": "RUN_LOCATION_BRIEF_GOLDEN=1 NODE_OPTIONS=--experimental-vm-modules jest --config=tests/integration/jest.testcontainers.config.js",
    "qa:location-brief-golden": "node scripts/qa-location-brief-golden-cases.js",
    "qa:live-documentation-links": "node scripts/run-live-documentation-links.cjs",
    "qa:pages:artifact": "node scripts/run-pages-quality-gate.cjs",
    "qa:e2e:prepare": "node scripts/prepare-extended-e2e.js && npm run build:site && playwright install --with-deps chromium firefox webkit",
    "qa:e2e:extended": "node scripts/run-extended-e2e.js",
    "qa:e2e:evidence": "node scripts/validate-screenshot-evidence.js --report out/qa/screenshot-evidence.json && node scripts/validate-doc-media.js --candidate-screenshots --report out/qa/documentation-media.json",
    "regen:demo": "node scripts/regen-readme-demo.js",
    "regen:context-assets": "node scripts/regen-context-assets.js",
    "generate:context-city": "node scripts/generate-context-city.js",
    "generate:accident-tiles": "node scripts/build-accident-tiles.js",
    "generate:pages-data": "node scripts/generate-pages-data.cjs",
    "validate:enrichment-inputs": "node scripts/check-enrichment-inputs.js",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:context-data-e2e": "node scripts/run-context-data-e2e.js",
    "test:performance": "jest --testPathPatterns=tests/performance",
    "test:render-gate": "node scripts/check-pdf-render.js --pdf out/ci-render-gate.pdf",
    "generate:sample-pdf": "node scripts/generate-sample-pdf.js --out out/ci-render-gate.pdf",
    "generate:sample-docx": "node scripts/generate-sample-docx.js --out out/ci-render-gate.docx",
    "qa:sample-docx-rendered": "node scripts/qa-sample-docx-rendered.js",
    "validate:word-compatibility": "node scripts/validate-word-compatibility-evidence.js",
    "validate:context-datasets": "node scripts/check-context-datasets.js",
    "validate:slope-plausibility": "node scripts/check-slope-plausibility.js",
    "validate:playwright-docker": "node scripts/check-playwright-docker-version.js",
    "validate:media": "node scripts/validate-doc-media.js",
    "validate:media:policy": "node scripts/validate-doc-media.js --policy-only",
    "validate:screenshot-evidence": "node scripts/validate-screenshot-evidence.js",
    "validate:vendor-provenance": "node scripts/validate-vendor-provenance.js",
    "validate:pages-profile": "node scripts/validate-public-pages-profile.js",
    "qa:slope": "node scripts/qa-slope-report.js",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "demo": "playwright test --project=demo",
    "prestart": "npm run build:site",
    "start": "node server/start.js",
    "prestart:server": "npm run build:site",
    "start:server": "node server/start.js",
    "start:docker": "docker compose up --build",
    "smoke": "bash scripts/smoke.sh"
  },
  "keywords": [
    "unfallatlas",
    "accident-data",
    "geojson",
    "visualization",
    "traffic-safety"
  ],
  "author": "Carsten Artur",
  "license": "Apache-2.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pdfjs-dist": "^6.1.200",
    "testcontainers": "^12.0.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost:8000/"
    },
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.testcontainers\\.test\\.js$"
    ],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "dependencies": {
    "@playwright/test": "1.61.1",
    "docx": "9.7.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "file-saver": "2.0.5",
    "leaflet": "1.9.4",
    "leaflet-draw": "1.0.4",
    "leaflet-image": "0.4.0",
    "leaflet.heat": "0.2.0",
    "leaflet.markercluster": "1.5.3",
    "pdfmake": "0.3.11"
  }
}
