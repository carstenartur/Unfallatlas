{
  "name": "unfallatlas",
  "version": "2.0.0",
  "description": "Unfallatlas data converter and analysis tool with interactive visualization",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPatterns=tests/unit",
    "test:integration": "jest --testPathPatterns=tests/integration",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:performance": "jest --testPathPatterns=tests/performance",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "demo": "playwright test --project=demo",
    "start:server": "node server/index.js"
  },
  "keywords": [
    "unfallatlas",
    "accident-data",
    "geojson",
    "visualization",
    "leaflet",
    "traffic-safety"
  ],
  "author": "Carsten Artur",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "pdfjs-dist": "^4.10.38"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost:8000/"
    },
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "dependencies": {
    "@playwright/test": "1.59.1",
    "docx": "9.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "file-saver": "2.0.5",
    "pdfmake": "0.3.7"
  }
}
