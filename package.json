{
  "name": "unfallatlas",
  "version": "2.1.4",
  "description": "Unfallatlas data converter and analysis tool with interactive visualization",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPatterns=tests/unit",
    "test:integration": "jest --testPathPatterns=tests/integration",
    "test:integration:tc": "NODE_OPTIONS=--experimental-vm-modules jest --config=tests/integration/jest.testcontainers.config.js",
    "test:location-brief-golden:tc": "RUN_LOCATION_BRIEF_GOLDEN=1 NODE_OPTIONS=--experimental-vm-modules jest --config=tests/integration/jest.testcontainers.config.js",
    "qa:location-brief-golden": "node scripts/qa-location-brief-golden-cases.js",
    "regen:demo": "node scripts/regen-readme-demo.js",
    "regen:context-assets": "node scripts/regen-context-assets.js",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:performance": "jest --testPathPatterns=tests/performance",
    "test:render-gate": "node scripts/check-pdf-render.js",
    "generate:sample-pdf": "node scripts/generate-sample-pdf.js",
    "validate:context-datasets": "node scripts/check-context-datasets.js",
    "validate:slope-plausibility": "node scripts/check-slope-plausibility.js",
    "validate:playwright-docker": "node scripts/check-playwright-docker-version.js",
    "qa:slope": "node scripts/qa-slope-report.js",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "demo": "playwright test --project=demo",
    "start": "node server/index.js",
    "start:server": "node server/index.js",
    "start:docker": "docker compose up --build",
    "smoke": "bash scripts/smoke.sh"
  },
  "keywords": [
    "unfallatlas",
    "accident-data",
    "geojson",
    "visualization",
    "leaflet",
    "traffic-safety"
  ],
  "author": "Carsten Artur",
  "license": "Apache-2.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pdfjs-dist": "^6.1.200",
    "testcontainers": "^12.0.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost:8000/"
    },
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.testcontainers\\.test\\.js$"
    ],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "dependencies": {
    "@playwright/test": "1.61.1",
    "docx": "9.7.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "file-saver": "2.0.5",
    "pdfmake": "0.3.11"
  }
}
