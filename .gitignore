out/*.zip
# Release website bundles are published as GitHub Release assets by
# .github/workflows/deploy-release.yml and must not be committed: the release
# job creates the ZIP before its `git add -A` step for the next development
# version, which previously pulled ~28 MB per release into the repository.
unfallatlas-website-*.zip
out/*.tmp
out/**/*.tmp
# CI render-gate output — generated by scripts/generate-sample-pdf.js, not committed.
out/ci-render-gate.pdf
# PR-berlin-slope-qa: diagnostic QA reports — generated on demand, not
# committed (CI uploads them as workflow artefacts instead).
out/qa/

# Maven build output (root reactor and the frontend-maven-plugin node/npm install)
target/
qa-system-tests/target/

# Testing
node_modules/
_site/
_site.tmp-*/
.build/
coverage/
test-results/
playwright-report/
.playwright/
*.log
