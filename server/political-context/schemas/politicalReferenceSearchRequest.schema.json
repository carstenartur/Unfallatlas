{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PoliticalReferenceSearchRequest",
  "type": "object",
  "required": ["city", "searchTerms"],
  "properties": {
    "city": { "type": "string", "minLength": 1, "maxLength": 100 },
    "searchTerms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "sourceLevels": { "type": "array", "maxItems": 5,
      "items": { "enum": ["city", "region", "state", "federal", "eu"] } },
    "context": {
      "type": "object",
      "properties": {
        "landtagNumber": { "type": "string", "pattern": "^\\d{1,2}/\\d{1,6}$", "maxLength": 9 },
        "landtagYear": { "type": "integer", "minimum": 1982, "maximum": 9999 }
      }
    },
    "maxResults": { "type": "integer", "minimum": 0, "maximum": 30 },
    "page": { "type": "string", "maxLength": 2048, "pattern": "^ris2\\.[A-Za-z0-9_-]+\\.[a-f0-9]{64}$" },
    "snapshot": { "$ref": "politicalReference.schema.json#/properties/snapshot" }
  },
  "dependencies": { "page": ["snapshot"] }
}
