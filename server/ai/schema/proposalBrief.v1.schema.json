{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "proposalBrief.v1",
  "title": "ProposalBriefV1Output",
  "description": "Antragsfähiger Maßnahmensteckbrief mit Kurz-/Langfassung, Prüfauftrag und Formulierungsbausteinen für deutsche kommunale Gremien.",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "shortVersion",
    "longVersion",
    "sachverhalt",
    "begruendung",
    "beschlussvorschlag",
    "pruefauftrag",
    "measureSummary",
    "confidence",
    "caveats"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "proposalBrief.v1"
    },
    "title": {
      "type": "string",
      "description": "Vorgeschlagener Antragstitel"
    },
    "shortVersion": {
      "type": "string",
      "description": "Kompakte Antragsfassung (max. ~120 Wörter), bürger- und gremiumstauglich"
    },
    "longVersion": {
      "type": "string",
      "description": "Ausführliche Antragsfassung mit Datenbezug (max. ~400 Wörter)"
    },
    "sachverhalt": {
      "type": "string",
      "description": "Sachverhaltsabschnitt für die Vorlage"
    },
    "begruendung": {
      "type": "string",
      "description": "Begründung mit Evidenzbezug"
    },
    "beschlussvorschlag": {
      "type": "string",
      "description": "Konkreter Beschlussvorschlag (formal)"
    },
    "pruefauftrag": {
      "type": "string",
      "description": "Konkreter Prüfauftrag an die Verwaltung"
    },
    "measureSummary": {
      "type": "array",
      "description": "Kurzliste der vorgeschlagenen Maßnahmen aus der Bibliothek (kein freies Halluzinieren).",
      "items": {
        "type": "object",
        "required": ["title", "category", "rationale"],
        "additionalProperties": false,
        "properties": {
          "id":        { "type": "string" },
          "title":     { "type": "string" },
          "category":  { "type": "string", "enum": ["quickWin", "infrastructure", "organizational", "monitoring"] },
          "rationale": { "type": "string" }
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["overall"],
      "additionalProperties": false,
      "properties": {
        "overall":   { "type": "string", "enum": ["high", "medium", "low"] },
        "rationale": { "type": "string" }
      }
    },
    "caveats": {
      "type": "array",
      "description": "Vorbehalte / Datenlücken / 'Achtung'-Hinweise, die im Antrag mit erwähnt werden sollten.",
      "items": { "type": "string" }
    }
  }
}
