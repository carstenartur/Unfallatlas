    "maxSingleFileBytes": 16777216,
    "maxTrackedBytes": 335544320,
    "maxChangedFiles": 5000,
    "maxAddedFiles": 1000,
    "maxDeletedFiles": 1000,
    "maxRewrittenBytes": 134217728,
    "maxPositiveGrowthBytes": 67108864,
    "maxNetGrowthBytes": 33554432,
    "maxEvidenceBytes": 4194304,
    "maxEvidenceFileBytes": 1048576,
    "maxPublishedDataBytes": 167772160
  },
  "evidencePrefixes": ["qa/", "docs/release-evidence/", "docs/storage-evidence/"],
  "diagnosticPrefixes": ["out/qa/", "coverage/", "test-results/", "playwright-report/", ".build/"],
  "rawDataPrefixes": ["raw/", "data/raw/", "out/raw/"],
