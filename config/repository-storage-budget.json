{
  "schemaVersion": 1,
  "contract": "unfallwerkbank-repository-storage/v1",
  "purpose": "Bound new Git storage while preserving accepted media and immutable legacy downloads. A PR is checked against its baseline policy, so a simultaneous policy increase cannot authorize oversized data.",
