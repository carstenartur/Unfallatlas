{
  "schemaVersion": 1,
  "contract": "unfallwerkbank-context-data-git-budget/v1",
  "purpose": "Fail-closed budget for unattended context-data commits. Larger intentional changes must use a reviewed pull request and, when appropriate, a reviewed policy update.",
  "allowedPathPrefixes": [
    "out/"
  ],
  "allowedExactPaths": [
    "data/accident-data-release.json"
  ],
  "limits": {
    "maxChangedFiles": 2000,
    "maxAddedFiles": 500,
    "maxDeletedFiles": 500,
    "maxSingleFileBytes": 16777216,
    "maxRewrittenBytes": 134217728,
    "maxPositiveGrowthBytes": 67108864,
    "maxNetGrowthBytes": 33554432
  }
}
