<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.unfallatlas</groupId>
    <artifactId>unfallatlas-build</artifactId>
    <version>2.1.4-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Unfallatlas Build</name>
    <description>
        Kanonischer Maven-Reaktor für Browseranwendung, Pages-Artefakt,
        Analysis Service und systemweite QA. GitHub Actions darf diesen Build
        nur aufrufen und keine parallele Build- oder Testlogik definieren.
    </description>

    <modules>
        <module>analysis-service</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <frontend-maven-plugin.version>2.0.1</frontend-maven-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <node.version>v24.17.0</node.version>
        <npm.version>11.9.0</npm.version>
        <skipTests>false</skipTests>
        <skip.pages.qa>true</skip.pages.qa>
        <pages.inputDir>out</pages.inputDir>
        <pages.poiDir>out</pages.poiDir>
        <pages.outputDir>_site</pages.outputDir>
        <skip.playwright.install>false</skip.playwright.install>
        <document.render.mode>all</document.render.mode>
        <documentation.liveLinks>false</documentation.liveLinks>
        <context.city></context.city>
        <context.force>false</context.force>
        <unfallatlas.contextData>false</unfallatlas.contextData>
        <unfallatlas.locationBriefGolden>false</unfallatlas.locationBriefGolden>
        <failsafe.includes>**/*IT.java</failsafe.includes>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.6,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <installDirectory>${project.build.directory}/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-pinned-node-and-npm</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-unit-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test:unit -- --runInBand</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-integration-tests</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test:integration</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-performance-tests</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test:performance</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pages-quality-gate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run qa:pages:artifact</arguments>
                            <skip>${skip.pages.qa}</skip>
                            <environmentVariables>
                                <PAGES_INPUT_DIR>${pages.inputDir}</PAGES_INPUT_DIR>
                                <PAGES_POI_DIR>${pages.poiDir}</PAGES_POI_DIR>
                                <PAGES_OUTPUT_DIR>${pages.outputDir}</PAGES_OUTPUT_DIR>
                                <SKIP_PLAYWRIGHT_INSTALL>${skip.playwright.install}</SKIP_PLAYWRIGHT_INSTALL>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>pages</id>
            <properties>
                <skip.pages.qa>false</skip.pages.qa>
            </properties>
        </profile>

        <profile>
            <id>pages-regenerated</id>
            <properties>
                <skip.pages.qa>false</skip.pages.qa>
                <pages.inputDir>.build/enriched</pages.inputDir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>generate-pages-data</id>
                                <phase>process-resources</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration>
                                    <arguments>run generate:pages-data</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>prepare-extended-browser-qa</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>run qa:e2e:prepare</arguments></configuration>
                            </execution>
                            <execution>
                                <id>extended-browser-qa</id>
                                <phase>integration-test</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>run qa:e2e:extended</arguments></configuration>
                            </execution>
                            <execution>
                                <id>validate-extended-browser-evidence</id>
                                <phase>verify</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>run qa:e2e:evidence</arguments></configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>system-it</id>
            <modules><module>qa-system-tests</module></modules>
        </profile>

        <profile>
            <id>video-export-it</id>
            <properties>
                <failsafe.includes>**/ProductionContainerIT.java</failsafe.includes>
            </properties>
            <modules><module>qa-system-tests</module></modules>
        </profile>

        <profile>
            <id>location-brief-golden</id>
            <properties>
                <unfallatlas.locationBriefGolden>true</unfallatlas.locationBriefGolden>
                <failsafe.includes>**/LocationBriefGoldenIT.java</failsafe.includes>
            </properties>
            <modules><module>qa-system-tests</module></modules>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>location-brief-golden-preflight</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration>
                                    <arguments>run qa:location-brief-golden</arguments>
                                    <environmentVariables>
                                        <GOLDEN_CASE_QA_ARTIFACT_PATH>out/qa/location-brief-golden-preflight.json</GOLDEN_CASE_QA_ARTIFACT_PATH>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                            <execution>
                                <id>prepare-location-brief-golden-fixtures</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration>
                                    <arguments>run qa:location-brief-golden:prepare</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>document-render</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>render-and-audit-documents</id>
                                <phase>integration-test</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration>
                                    <arguments>run qa:document-render</arguments>
                                    <environmentVariables>
                                        <DOCUMENT_RENDER_MODE>${document.render.mode}</DOCUMENT_RENDER_MODE>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>context-data-e2e</id>
            <properties>
                <unfallatlas.contextData>true</unfallatlas.contextData>
                <failsafe.includes>**/ContextDataContainerIT.java</failsafe.includes>
            </properties>
            <modules><module>qa-system-tests</module></modules>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>generate-and-validate-context-data</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration>
                                    <arguments>run qa:context-enrichment</arguments>
                                    <environmentVariables>
                                        <CONTEXT_CITY>${context.city}</CONTEXT_CITY>
                                        <FORCE_CONTEXT>${context.force}</FORCE_CONTEXT>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>documentation-live</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>generate-and-validate-live-documentation</id>
                                <phase>integration-test</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration>
                                    <arguments>run qa:documentation-live</arguments>
                                    <environmentVariables>
                                        <DOCUMENTATION_LIVE_LINKS>${documentation.liveLinks}</DOCUMENTATION_LIVE_LINKS>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>release-site</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>build-and-validate-release-site</id>
                                <phase>verify</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>run qa:release-site</arguments></configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
