<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.unfallatlas</groupId>
    <artifactId>unfallatlas-build</artifactId>
    <version>2.1.4-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Unfallatlas Build</name>
    <description>
        Kanonischer Maven-Reaktor für Browseranwendung, Pages-Artefakt,
        Analysis Service und systemweite QA. GitHub Actions darf diesen Build
        nur aufrufen und keine parallele Build- oder Testlogik definieren.
    </description>

    <modules>
        <module>analysis-service</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <node.version>v24.17.0</node.version>
        <npm.version>11.19.0</npm.version>
        <skipTests>false</skipTests>
        <skip.pages.qa>true</skip.pages.qa>
        <pages.inputDir>out</pages.inputDir>
        <pages.poiDir>out</pages.poiDir>
        <pages.outputDir>_site</pages.outputDir>
        <skip.playwright.install>false</skip.playwright.install>
        <document.render.mode>all</document.render.mode>
        <documentation.liveLinks>false</documentation.liveLinks>
        <context.city></context.city>
        <context.force>false</context.force>
        <unfallatlas.contextData>false</unfallatlas.contextData>
        <unfallatlas.locationBriefGolden>false</unfallatlas.locationBriefGolden>
        <failsafe.includes>**/*IT.java</failsafe.includes>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.6,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <installDirectory>${project.build.directory}/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-pinned-node-and-npm</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-unit-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test:unit -- --runInBand</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-integration-tests</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test:integration</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-server-unit-tests</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test:server</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-static-data</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run validate:static-data</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-city-rollout</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run validate:city-rollout</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-city-coverage</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run validate:accident-coverage</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-slope-plausibility</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run qa:slope</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-pages-site</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build:site -- --input ${pages.inputDir} --poi ${pages.poiDir} --output ${pages.outputDir}</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-pages-site</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.pages.qa}</skip>
                            <arguments>run qa:pages -- --site ${pages.outputDir}</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-pages-site-browser</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.pages.qa}</skip>
                            <arguments>run qa:pages-browser -- --site ${pages.outputDir}</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-document-golden-matrix</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run qa:document-golden</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-rendered-document-golden-matrix</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run qa:document-golden:rendered</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-and-validate-live-documentation</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <skip>${!documentation.liveLinks}</skip>
                            <arguments>run qa:documentation-live</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-location-brief-golden-case</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <skip>${!unfallatlas.locationBriefGolden}</skip>
                            <arguments>run qa:location-brief-golden</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-context-data</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <skip>${!unfallatlas.contextData}</skip>
                            <arguments>run generate:context -- --city ${context.city} ${context.force}</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.6</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>${failsafe.includes}</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>pages</id>
            <properties>
                <skip.pages.qa>false</skip.pages.qa>
            </properties>
        </profile>
        <profile>
            <id>documentation-live</id>
            <properties>
                <documentation.liveLinks>true</documentation.liveLinks>
            </properties>
        </profile>
        <profile>
            <id>context-data</id>
            <properties>
                <unfallatlas.contextData>true</unfallatlas.contextData>
            </properties>
        </profile>
        <profile>
            <id>location-brief-golden</id>
            <properties>
                <unfallatlas.locationBriefGolden>true</unfallatlas.locationBriefGolden>
            </properties>
        </profile>
    </profiles>
</project>
