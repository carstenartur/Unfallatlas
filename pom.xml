<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.unfallatlas</groupId>
    <artifactId>unfallatlas-build</artifactId>
    <version>2.1.4-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Unfallatlas Build</name>
    <description>
        Kanonischer Maven-Reaktor für Browseranwendung, Pages-Artefakt und
        Analysis Service. GitHub Actions darf diesen Build nur aufrufen und
        keine parallele Build- oder Testlogik definieren.
    </description>

    <modules>
        <module>analysis-service</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <frontend-maven-plugin.version>2.0.0</frontend-maven-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <node.version>v24.17.0</node.version>
        <npm.version>11.9.0</npm.version>
        <skipTests>false</skipTests>
        <pages.inputDir>out</pages.inputDir>
        <pages.poiDir>out</pages.poiDir>
        <pages.outputDir>_site</pages.outputDir>
        <skip.playwright.install>false</skip.playwright.install>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.6,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <installDirectory>${project.build.directory}/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-pinned-node-and-npm</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-unit-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test:unit -- --runInBand</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-integration-tests</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test:integration</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-performance-tests</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test:performance</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Vollständiger Pages-Vertrag gegen die Daten des Checkouts:

              mvn clean verify -Ppages

          Derselbe Befehl wird in CI verwendet. Abweichende Datenquellen werden
          ausschließlich als Maven-Properties übergeben, zum Beispiel:

              mvn clean verify -Ppages \
                  -Dpages.inputDir=.build/enriched \
                  -Dpages.poiDir=out
        -->
        <profile>
            <id>pages</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>pages-quality-gate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run qa:pages:artifact</arguments>
                                    <skip>${skipTests}</skip>
                                    <environmentVariables>
                                        <PAGES_INPUT_DIR>${pages.inputDir}</PAGES_INPUT_DIR>
                                        <PAGES_POI_DIR>${pages.poiDir}</PAGES_POI_DIR>
                                        <PAGES_OUTPUT_DIR>${pages.outputDir}</PAGES_OUTPUT_DIR>
                                        <SKIP_PLAYWRIGHT_INSTALL>${skip.playwright.install}</SKIP_PLAYWRIGHT_INSTALL>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
