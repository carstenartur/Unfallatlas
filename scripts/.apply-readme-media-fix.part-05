  source = source.replaceAll('Gerenderte PDF-Belegseite',
    'Zweiseitige PDF-Gesamtvorschau');
  return source;
}

function patchManifest(source) {
  const manifest = JSON.parse(source);
  manifest.defaults.reviewPolicy = 'Statische Kartenmedien müssen ihr deklariertes Zielmaß und das 1,5-MiB-Einzelbudget einhalten; das 30-MiB-Gesamtbudget umfasst reale hochentropische Grundkarten, die zweiseitige Dokumentvorschau und die explizit budgetierte, aus dem Serverexport regenerierte Animation. Nutzerseitige Screenshots benötigen einen reproduzierbaren Analyse-Link und ein bei README-Skalierung sichtbar bleibendes Unfallsignal.';
  const byPath = new Map(manifest.assets.map((asset) => [asset.path, asset]));
  const hbf = byPath.get('docs/screenshots/13-bonn-hbf-radunfaelle.png');
  const report = byPath.get('docs/screenshots/14-export-filterkontext.png');
  const pdf = byPath.get('docs/screenshots/15-export-pdf-rendered.png');
  if (!hbf || !report || !pdf) throw new Error('Featured media manifest entries are missing');
  hbf.purpose = 'Bonn-Hbf-Szenario Rad/Pkw mit sichtbaren nummerierten Clustern, Heatmap und Auswahlbereich.';
  hbf.target = { width: 1774, height: 887 };
  report.purpose = 'Exportvorschau mit aktivem Filter- und Auswahlkontext sowie außerhalb des Dialogs sichtbaren Unfallclustern.';
  report.target = { width: 1774, height: 887 };
  pdf.purpose = 'Zweiseitige PDF-Gesamtvorschau mit Kartenanlage, Methodik und Beschlussvorschlag.';
  pdf.target = { width: 1774, height: 887 };
  delete pdf.maxBytes;
  return `${JSON.stringify(manifest, null, 2)}\n`;
}

function patchScreenshotGuide(source) {
  source = replaceExact(
    source,
    '1. Anwendungsscreenshots haben grundsätzlich **1280 × 640 px**.',
    '1. Anwendungsscreenshots haben grundsätzlich **1280 × 640 px**. Die drei hervorgehobenen README-Medien `13`, `14` und `15` verwenden für lesbare Karten-, Dialog- und Doppelseiteninhalte **1774 × 887 px**.',
    'document featured media dimensions'
  );
  source = replaceExact(
    source,
    '7. Die kanonische Animation `docs/demo.gif` wird ausschließlich aus dem\n   serverseitigen Videoexport regeneriert. Ein zweiter, davon abweichender\n   Aufnahmeablauf ist nicht zulässig.',
    '7. Die kanonische Animation `docs/demo.gif` wird ausschließlich aus dem\n   serverseitigen Videoexport regeneriert. Ein zweiter, davon abweichender\n   Aufnahmeablauf ist nicht zulässig.\n8. Ein im README hervorgehobenes Kartenbild muss bei GitHub-Skalierung ein\n   menschlich erkennbares Unfallsignal behalten. Für die kombinierte Hbf-Ansicht\n   werden deshalb Heatmap **und** mindestens fünf sichtbare nummerierte Cluster\n   geprüft; beim Exportdialog müssen mindestens drei Cluster außerhalb des\n   Dialogs sichtbar bleiben.',
    'add human-visible accident signal rule'
  );
  source = source.replace('- `13-bonn-hbf-radunfaelle.png`',
    '- `13-bonn-hbf-radunfaelle.png` – kombinierte Cluster-/Heatmapansicht; sichtbares Unfallsignal ist ein hartes Gate');
  source = source.replace('- `14-export-filterkontext.png`',
    '- `14-export-filterkontext.png` – Berichtsdialog mit weiterhin sichtbaren Unfallclustern im Kartenrand');
  source = source.replace('- `15-export-pdf-rendered.png`',
    '- `15-export-pdf-rendered.png` – vollständige zweiseitige PDF-Gesamtvorschau mit Kartenanlage und Beschlussvorschlag');
  return source;
}

function patchVisualWorkflow(source) {
  return replaceExact(
    source,
    `      - 'tests/unit/documentationDeepLinkContract.test.js'\n      - '.github/workflows/visual-check.yml'`,
    `      - 'tests/unit/documentationDeepLinkContract.test.js'\n      - 'tests/unit/featuredDocumentationMediaContract.test.js'\n      - '.github/workflows/visual-check.yml'`,
    'trigger visual QA for featured media contract'
  );
}

function patchDocMediaPolicy(source) {
  return replaceExact(
    source,
    `  test('new full-screen screenshot candidates target 1280x640', () => {\n    const documentPreview = 'docs/screenshots/15-export-pdf-rendered.png';\n    for (const asset of manifest.assets.filter(entry => entry.kind === 'screenshot')) {\n      if (asset.path !== documentPreview) expect(asset.target).toEqual({ width: 1280, height: 640 });\n    }\n    const screenshotSpec = fs.readFileSync(path.join(ROOT, 'tests/e2e/screenshots.spec.js'), 'utf8');\n    expect(screenshotSpec).toMatch(/viewport:\\s*\\{\\s*width:\\s*1280,\\s*height:\\s*640\\s*\\}/);\n  });`,
    `  test('documentation screenshots use their reviewed scenario dimensions', () => {\n    const featured = new Set([\n      'docs/screenshots/13-bonn-hbf-radunfaelle.png',\n      'docs/screenshots/14-export-filterkontext.png',\n    ]);\n    for (const asset of manifest.assets.filter(entry => entry.kind === 'screenshot')) {\n      expect(asset.target).toEqual(featured.has(asset.path)\n        ? { width: 1774, height: 887 }\n        : { width: 1280, height: 640 });\n    }\n    const documentPreview = manifest.assets.find(\n      entry => entry.path === 'docs/screenshots/15-export-pdf-rendered.png'\n    );\n    expect(documentPreview.target).toEqual({ width: 1774, height: 887 });\n    const screenshotSpec = fs.readFileSync(path.join(ROOT, 'tests/e2e/screenshots.spec.js'), 'utf8');\n    expect(screenshotSpec).toMatch(/viewport:\\s*\\{\\s*width:\\s*1280,\\s*height:\\s*640\\s*\\}/);\n    expect(screenshotSpec).toContain('setViewportSize({ width: 1774, height: 887 })');\n  });`,
    'allow explicitly reviewed featured media dimensions'
  );
}

function patchPom(source) {
  return replaceExact(
    source,
    `                            <execution>\n                                <id>generate-and-validate-live-documentation</id>`,
    `                            <execution>\n                                <id>frontend-unit-tests</id>\n                                <configuration><skip>true</skip></configuration>\n                            </execution>\n                            <execution>\n                                <id>frontend-integration-tests</id>\n                                <configuration><skip>true</skip></configuration>\n                            </execution>\n                            <execution>\n                                <id>frontend-performance-tests</id>\n                                <configuration><skip>true</skip></configuration>\n                            </execution>\n                            <execution>\n                                <id>generate-and-validate-live-documentation</id>`,
    'skip only unrelated frontend suites in the documentation-live profile'
  );
}

