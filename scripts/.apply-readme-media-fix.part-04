    'README export screenshot alt text'
  );
  source = replaceExact(
    source,
    'Gerenderte Vorschau eines PDF-Exports',
    'Zweiseitige PDF-Gesamtvorschau mit Kartenanlage, Methodik und Beschlussvorschlag',
    'README PDF spread alt text'
  );
  return source;
}

