  source = replaceRegex(
    source,
    /    const pdfDiagnostics = await page\.evaluate\(\(\) => \(\{[\s\S]*?    expect\(pdfDiagnostics\.renderedPageText\)\.not\.toMatch\(\/\^\(\?:Wochentag[\s\S]*?\);/,
    newDiagnostics,
    'validate the complete two-page PDF spread'
  );

  source = replaceExact(
    source,
    `    // Screenshot der ersten PDF-Seite, auf der die zuvor aus dem Exportmodell\n    // verifizierte lokale Unfallzahl tatsächlich genannt wird.`,
    `    // Screenshot zweier repräsentativer vollständiger PDF-Seiten: Methodik und\n    // Beschlussvorschlag auf der ersten, Übersicht und Auswahlkarte auf der zweiten.`,
    'update PDF screenshot intent'
  );
  source = replaceExact(
    source,
    `    await page.locator('#pdf-canvas').screenshot({ path: screenshotPath });`,
    `    await page.locator('#pdf-spread').screenshot({ path: screenshotPath });`,
    'capture complete PDF spread'
  );

  return source;
}

function patchDeepLinkContract(source) {
  source = replaceRegex(
    source,
    /(const HBF_HEATMAP_QUERY = query\(\{[\s\S]*?"involvementMode": "and",\n  )"showCluster": "0"/,
    '$1"showCluster": "1"',
    'canonical HBF query enables clusters'
  );
  source = replaceExact(
    source,
    `    id: 'docs-bonn-hbf-heatmap',\n    description: 'Bonn Hbf mit Rad/Pkw-UND-Filter, Heatmap und Auswahl',`,
    `    id: 'docs-bonn-hbf-cluster-heatmap',\n    description: 'Bonn Hbf mit Rad/Pkw-UND-Filter, sichtbaren Clustern, Heatmap und Auswahl',`,
    'describe combined HBF visual'
  );
  source = replaceRegex(
    source,
    /(const HBF_HEATMAP_EXPECTED = Object\.freeze\(\{[\s\S]*?hourTo: 23,\n  )showCluster: false/,
    '$1showCluster: true',
    'live HBF scenario expects visible clusters'
  );
  source = replaceExact(
    source,
    `    description: 'Bonn Hbf Rad/Pkw UND, Heatmap und markierter Bereich',`,
    `    description: 'Bonn Hbf Rad/Pkw UND mit Clustern, Heatmap und markiertem Bereich',`,
    'update HBF action description'
  );
  return source;
}

