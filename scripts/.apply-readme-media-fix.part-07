  const evidenceRoot = absolute('qa/screenshot-evidence');
  const readinessTarget = path.join(evidenceRoot, 'readiness');
  fs.rmSync(readinessTarget, { recursive: true, force: true });
  fs.mkdirSync(readinessTarget, { recursive: true });
  for (const name of fs.readdirSync(readinessSource).filter((entry) => entry.endsWith('.json')).sort()) {
    fs.copyFileSync(path.join(readinessSource, name), path.join(readinessTarget, name));
  }
  fs.copyFileSync(summarySource, path.join(evidenceRoot, 'summary.json'));
  fs.copyFileSync(cartographySource, path.join(evidenceRoot, 'live-cartography.json'));

  const summaryPath = path.join(evidenceRoot, 'summary.json');
  const cartographyPath = path.join(evidenceRoot, 'live-cartography.json');
  const summary = JSON.parse(fs.readFileSync(summaryPath, 'utf8'));
  const cartography = JSON.parse(fs.readFileSync(cartographyPath, 'utf8'));
  const buildManifest = JSON.parse(fs.readFileSync(buildManifestPath, 'utf8'));
  if (summary.valid !== true || cartography.valid !== true) {
    throw new Error('Generated screenshot or cartography evidence is not valid');
  }

  const screenshotEntries = summary.screenshots
    .slice()
    .sort((a, b) => a.path.localeCompare(b.path))
    .map((entry) => `${entry.path}\t${entry.sha256}\t${entry.bytes}\n`)
    .join('');
  const readinessFiles = fs.readdirSync(readinessTarget).filter((entry) => entry.endsWith('.json')).sort();
  let readinessBytes = 0;
  let readinessEntries = '';
  for (const name of readinessFiles) {
    const file = path.join(readinessTarget, name);
    const bytes = fs.statSync(file).size;
    readinessBytes += bytes;
    readinessEntries += `${name}\t${sha256(file)}\t${bytes}\n`;
  }

  const artifactSha = String(process.env.SCREENSHOT_ARTIFACT_SHA256 || '')
    .trim()
    .replace(/^sha256:/i, '');
  if (!/^[a-f0-9]{64}$/.test(artifactSha)) {
    throw new Error('SCREENSHOT_ARTIFACT_SHA256 must bind the exact promoted ZIP');
  }
  const artifactId = Number(process.env.SCREENSHOT_ARTIFACT_ID || 0);
  if (!Number.isSafeInteger(artifactId) || artifactId <= 0) {
    throw new Error('SCREENSHOT_ARTIFACT_ID is required for durable screenshot provenance');
  }
  const workflowRunId = Number(process.env.GITHUB_RUN_ID || 0);
  if (!Number.isSafeInteger(workflowRunId) || workflowRunId <= 0) {
    throw new Error('GITHUB_RUN_ID is required for durable screenshot provenance');
  }
  const artifactName = String(process.env.SCREENSHOT_ARTIFACT_NAME || '').trim();
  if (!artifactName) throw new Error('SCREENSHOT_ARTIFACT_NAME is required');

  const provenance = {
    schemaVersion: 1,
    purpose: `Durable checked-in binding for the human-reviewed README screenshot repair generated by GitHub Actions run ${workflowRunId}.`,
    source: {
      artifactName,
      artifactId,
      artifactZipSha256: artifactSha,
      evidenceRevision: summary.revision,
      evidenceStatus: 'valid',
      evidenceCount: summary.screenshots.length,
    },
    build: {
      manifestSha256: sha256(buildManifestPath),
      fingerprint: buildManifest.fingerprint,
      applicationFingerprint: buildManifest.application && buildManifest.application.fingerprint,
      dataFingerprint: buildManifest.data && buildManifest.data.fingerprint,
    },
    summary: {
      path: 'qa/screenshot-evidence/summary.json',
      sha256: sha256(summaryPath),
      entriesSha256: crypto.createHash('sha256').update(screenshotEntries).digest('hex'),
    },
    cartography: {
      path: 'qa/screenshot-evidence/live-cartography.json',
      sha256: sha256(cartographyPath),
      schemaVersion: cartography.schemaVersion,
      validCartographic: cartography.totals && cartography.totals.validCartographic,
      exempt: cartography.totals && cartography.totals.exempt,
    },
    readiness: {
      directory: 'qa/screenshot-evidence/readiness',
      files: readinessFiles.length,
      bytes: readinessBytes,
      entriesSha256: crypto.createHash('sha256').update(readinessEntries).digest('hex'),
    },
  };
  write('qa/screenshot-evidence/provenance.json', JSON.stringify(provenance, null, 2));
  process.stdout.write(`[apply-media-fix] promoted ${summary.screenshots.length} screenshot evidence records\n`);
}

function cleanupBootstrap() {
  fs.rmSync(absolute(SELF), { force: true });
