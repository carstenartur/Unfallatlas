  fs.rmSync(absolute(WORKFLOW), { force: true });
  process.stdout.write('[apply-media-fix] removed bootstrap files\n');
}

function applyMediaBudgetCorrections() {
  patchFile('docs/media-manifest.json', (source) => {
    const manifest = JSON.parse(source);
    const hbf = manifest.assets.find(
      (asset) => asset.path === 'docs/screenshots/13-bonn-hbf-radunfaelle.png'
    );
    if (!hbf) throw new Error('Featured HBF manifest entry is missing');
    hbf.target = { width: 1280, height: 640 };
    return `${JSON.stringify(manifest, null, 2)}\n`;
  });
  patchFile('docs/screenshots/README.md', (source) => replaceExact(
    source,
    '1. Anwendungsscreenshots haben grundsätzlich **1280 × 640 px**. Die drei hervorgehobenen README-Medien `13`, `14` und `15` verwenden für lesbare Karten-, Dialog- und Doppelseiteninhalte **1774 × 887 px**.',
    '1. Anwendungsscreenshots haben grundsätzlich **1280 × 640 px**. Das Hbf-Kartenbild `13` folgt diesem Standard und wird zusätzlich durch ein Sichtbarkeits-Gate geschützt; die Dialog- und Doppelseitenmedien `14` und `15` verwenden **1774 × 887 px**.',
    'keep HBF screenshot within the standard static-media budget'
  ));
  patchFile('tests/unit/docMediaPolicy.test.js', (source) => replaceExact(
    source,
    `    const featured = new Set([\n      'docs/screenshots/13-bonn-hbf-radunfaelle.png',\n      'docs/screenshots/14-export-filterkontext.png',\n    ]);`,
    `    const featured = new Set([\n      'docs/screenshots/14-export-filterkontext.png',\n    ]);`,
    'apply the standard dimensions to the HBF screenshot'
  ));
}

const command = process.argv[2];
if (command === 'apply') {
  applyPatches();
  applyMediaBudgetCorrections();
} else if (command === 'promote') promoteEvidence();
else if (command === 'cleanup') cleanupBootstrap();
else throw new Error('Usage: node scripts/apply-readme-media-fix.cjs <apply|promote|cleanup>');
