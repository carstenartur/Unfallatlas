<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>de.unfallatlas</groupId>
    <artifactId>unfallatlas-analysis-service</artifactId>
    <version>2.1.2-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Unfallatlas Analysis Service</name>
    <description>
        Separater Spring-Boot-/Hibernate-Persistenzdienst für die Kernobjekte
        des Location Action Brief (PR #199).  Die bestehende Node.js-Anwendung
        bleibt unverändert; dieser Dienst läuft daneben.
    </description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- CVE-Override: Spring-Boot 3.3.5 managed PostgreSQL 42.7.4 ist
             betroffen von "pgjdbc Client Allows Fallback to Insecure
             Authentication Despite channelBinding=require Configuration"
             (Patched in 42.7.7). -->
        <postgresql.version>42.7.7</postgresql.version>
        <!-- Spring Boot 4.0.6 manages Hibernate ORM 7.2.x.  Hibernate Search
             must stay on the 8.2.x line; newer 8.3/8.4 lines target newer
             Hibernate ORM minor versions and fail during auto-indexing. -->
        <hibernate-search.version>8.4.0.Final</hibernate-search.version>
    </properties>

    <dependencies>
        <!-- Web + JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA / Hibernate ORM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation (Hibernate Validator unter der Haube) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Datenbanken: H2 für Dev/Tests, PostgreSQL als Default für Prod -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema-Migrationen (PostgreSQL + H2-Compatibility-Modus).
             Spring Boot 4 hat die Flyway-Autoconfiguration in einen eigenen
             Starter ausgelagert; diese Abhängigkeit ist nötig, damit Flyway
             beim Boot automatisch das Schema migriert. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Actuator: Health, Info, Metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Batch: Grundlage für stadtweite Verarbeitungsläufe.
             Metadatentabellen werden über Flyway angelegt
             (V3__analysis_job_batch_link.sql), nicht über Spring Boots
             initialize-schema. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>

        <!-- Hibernate Search: praktisch nutzbare Suchschicht über
             LocationActionBriefEntity + PoliticalReferenceSummaryEntity +
             CandidateMeasureAssessmentEntity (siehe @Indexed-Annotationen).
             Backend: Lokales Lucene-Filesystem (kein zusätzlicher
             Infra-Bedarf).  Bootstrap und automatisches Indexing werden
             über `application.properties` gesteuert.

             Spring Boot 4.0.6 manages Hibernate ORM 7.2.x.  Hibernate Search
             8.2.2.Final is the matching 8.x line for ORM 7.2; newer 8.3/8.4
             lines target ORM 7.3/7.4 and can fail with missing Hibernate SPI
             classes during auto-indexing. -->
        <dependency>
            <groupId>org.hibernate.search</groupId>
            <artifactId>hibernate-search-mapper-orm</artifactId>
            <version>${hibernate-search.version}</version>
            <exclusions>
                <!-- Wir ziehen hibernate-core über Spring Boot, damit wir
                     bei der gemanagten Version (7.2.x) bleiben. -->
                <exclusion>
                    <groupId>org.hibernate.orm</groupId>
                    <artifactId>hibernate-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.hibernate.search</groupId>
            <artifactId>hibernate-search-backend-lucene</artifactId>
            <version>${hibernate-search.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Spring Boot 4 hat die Test-Slice-Infrastruktur modularisiert.
          Test-Annotationen wie @AutoConfigureMockMvc / @DataJpaTest /
          @AutoConfigureTestDatabase liegen jetzt unter den modul-spezifischen
          Test-Startern (siehe Spring Boot 4.0 Release Notes:
          "Modularization of Test Infrastructure").
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
